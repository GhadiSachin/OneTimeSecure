# -------------------------------------------------------------------
# OneTime Secure - Environment Configuration Example
# -------------------------------------------------------------------
# Rename this file to .env and populate it with your configuration
# Do NOT commit your actual .env file to version control.
# -------------------------------------------------------------------

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://your_db_user:your_db_password@localhost:5432/onetimesecure

# Server Configuration
PORT=8080
NODE_ENV=development

# Application URL (for generating shareable links)
VITE_APP_URL=http://localhost:8080
